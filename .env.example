# Base de datos PostgreSQL (sin ella se usa un almacén en memoria NO persistente).
DATABASE_URL="postgresql://usuario:contraseña@host:5432/dharma_kadabra"

# Secreto para firmar sesiones del equipo (NextAuth) y de clientes.
# Obligatorio en producción. Genera uno con: openssl rand -base64 32
AUTH_SECRET=""

# URL pública del sitio (NextAuth). En Vercel se detecta automáticamente.
NEXTAUTH_URL="https://tu-dominio.com"

# Secreto que Vercel Cron envía como "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# Solo desarrollo local sin DATABASE_URL: crea una administradora en memoria.
# Se ignora cuando NODE_ENV=production.
DEV_ADMIN_EMAIL=""
DEV_ADMIN_PASSWORD=""
