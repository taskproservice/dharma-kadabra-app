# Cozy · DeepSeek (configuradas en Vercel → Settings → Environment Variables)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Opcionales
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Orígenes extra permitidos para /api/cozy (el dominio que sirve la app y las URLs de Vercel ya se permiten solos)
# COZY_ALLOWED_ORIGINS=https://dharmakadabra.com,https://www.dharmakadabra.com
