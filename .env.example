# Base de datos PostgreSQL (sin ella se usa un almacén en memoria NO persistente).
DATABASE_URL="postgresql://usuario:contraseña@host:5432/dharma_kadabra"

# Conexión directa sin pooler (migraciones / db push). Debe ser igual a DIRECT_URL.
DATABASE_URL_UNPOOLED="postgresql://usuario:contraseña@host:5432/dharma_kadabra"

# Secreto para firmar sesiones del equipo (NextAuth) y de clientes.
# Obligatorio en producción. Genera uno con: openssl rand -base64 32
AUTH_SECRET=""

# URL pública del sitio (NextAuth). En Vercel se detecta automáticamente.
NEXTAUTH_URL="https://tu-dominio.com"

# Secreto que Vercel Cron envía como "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# Solo desarrollo local sin DATABASE_URL: crea una administradora en memoria.
# Se ignora cuando NODE_ENV=production.
DEV_ADMIN_EMAIL=""
DEV_ADMIN_PASSWORD=""

# Holistic Store · WhatsApp comercial (solo dígitos, con código de país).
# Se usa en la transferencia a humano desde el chat de Cozy (botón
# "Hablar con un asesor humano" / detección de frustración).
NEXT_PUBLIC_STORE_WHATSAPP="5216641234567"

# Cozy · Agente de ventas (POST /api/cozy).
# Con API key usa el modelo de lenguaje con el System Prompt de Asesora de
# Ventas Experta; sin key usa el respondedor local con el contexto del
# producto (envíos, cuidados, energía, agotado y transferencia a humano).
OPENAI_API_KEY=""
# Modelo opcional (por defecto: gpt-4o-mini).
OPENAI_MODEL="gpt-4o-mini"

# URL pública del sitio (enlaces de recuperación y confirmaciones por correo).
# En Vercel: https://tu-dominio.vercel.app o tu dominio propio.
NEXT_PUBLIC_APP_URL="https://tu-dominio.com"

# Resend · Correos transaccionales (recuperación de contraseña, confirmación
# de cita). Sin key, los correos se simulan en consola ([Mock Resend]).
RESEND_API_KEY=""
# Remitente verificado en Resend (dominio verificado).
RESEND_FROM_EMAIL="Dharma Kadabra <hola@dharmakadabra.mx>"

# Vercel Blob · Almacenamiento durable de imágenes de producto y video del
# Tour. En Vercel se inyecta automáticamente al conectar un Blob Store;
# sin token, las subidas caen al disco local (solo desarrollo).
BLOB_READ_WRITE_TOKEN=""

# Redes sociales del footer (sin ellas se muestra "Próximamente").
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
