# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dharma_kadabra?schema=public"

# DeepSeek key for the Cozy chat (server-side only; never expose this as NEXT_PUBLIC_*)
DEEPSEEK_API_KEY=""
# Optional; defaults to deepseek-chat
DEEPSEEK_MODEL="deepseek-chat"
