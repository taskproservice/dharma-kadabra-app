// Prisma schema for Dharma Kadabra
// Production schema for appointments & automated notification reminders

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ENGINEER
  SOCIAL_MEDIA
  COLLABORATOR
  CLIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
}

model Appointment {
  id                String            @id @default(cuid())
  clientName        String
  clientPhone       String
  date              DateTime
  service           String
  status            AppointmentStatus @default(PENDING)
  notificationsSent Json              @default("[]")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([date, status])
}
