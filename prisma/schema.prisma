// Prisma schema for Dharma Kadabra
// PostgreSQL persistence for bookings, customers, store items and ritual events.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED") // Recomendado para Vercel (migraciones seguras)
}

// Roles del equipo (RBAC). CLIENT se reserva para las cuentas de tienda,
// que viven en `Customer` y usan su propia sesión.
enum Role {
  ADMIN
  ENGINEER
  COLLABORATOR
  MARKETING
  CLIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
}

// Modalidad obligatoria de cada cita: estudio presencial o videollamada.
enum Modality {
  IN_PERSON
  VIDEO_CALL
}

// Cuentas del equipo (dashboard). Se autentican con NextAuth (Credentials).
// Los clientes de la tienda usan el modelo Customer y su propia sesión.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(COLLABORATOR)
  active       Boolean  @default(true)
  // Disponibilidad semanal del colaborador: [{ "weekday": 0-6, "hour": 9-18 }, ...]
  weeklyAvailability Json             @default("[]")
  assignedAppointments Appointment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Appointment {
  id                String            @id @default(cuid())
  clientName        String
  clientEmail       String
  clientPhone       String
  date              DateTime
  service           String
  // Modalidad obligatoria: presencial en el estudio o videollamada (Zoom/Meet).
  modality          Modality          @default(IN_PERSON)
  status            AppointmentStatus @default(PENDING)
  depositPaid       Boolean           @default(false)
  notificationsSent Json              @default("[]")
  customerId        String?
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Colaborador responsable de la sesión (la agenda del rol COLLABORATOR
  // solo muestra las citas que le fueron asignadas).
  assigneeId        String?
  assignee          User?             @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([date, status])
  @@index([clientEmail, date])
  @@index([assigneeId, date])
}

model Customer {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  phone          String?
  passwordHash   String
  appointments   Appointment[]
  purchases      Purchase[]
  audioPurchases AudioPurchase[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Product {
  id           String         @id
  name         String
  description  String
  price        Float
  // Holistic Store · administración comercial
  cost         Float          @default(0)
  profitMargin Float          @default(0)
  currency     String         @default("MXN")
  availability String         @default("available")
  published    Boolean        @default(false)
  // Botón de visibilidad del panel de Marketing: si se apaga, la pieza
  // desaparece de la tienda pública sin borrar el registro.
  isVisible    Boolean        @default(true)
  stock        Int            @default(0)
  imageUrl     String
  category     String
  events       SpecialEvent[] @relation("EventProducts")
  purchases    Purchase[]
  views        ProductView[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([category, published, isVisible])
}

model SpecialEvent {
  id          String    @id @default(cuid())
  title       String
  description String
  date        DateTime
  products    Product[] @relation("EventProducts")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([date])
}

model Purchase {
  id         String   @id @default(cuid())
  customerId String
  productId  String?
  title      String
  purchasedAt DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([customerId, purchasedAt])
}

model AudioPurchase {
  id          String   @id @default(cuid())
  customerId  String
  title       String
  audioUrl    String?
  purchasedAt DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, purchasedAt])
}

// Holistic Store · plantilla visual asignada a cada categoría de la tienda.
// Valores de `template`: "oro" | "papiro" | "fuego" (ver modules/holistic-store).
model StoreCategoryStyle {
  category  String   @id
  template  String   @default("oro")
  updatedAt DateTime @updatedAt
}

// Tour de marca · video inmersivo de la landing ("Quiénes somos") con capítulos
// sincronizados por tiempo. Se administra desde /dashboard/tour y se consume en
// components/landing/brand-tour-modal.tsx.
// Formato de `chapters`: [{ "time": 5, "label": "Nuestra Historia", "text": "…" }]
// (tiempo en segundos desde el inicio del video).
model TourVideo {
  id        String   @id @default(cuid())
  title     String
  videoUrl  String
  chapters  Json     @default("[]")
  ctaText   String   @default("Explorar la Colección")
  ctaLink   String   @default("#coleccion")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ajustes operativos del sistema (panel de Ingeniería).
// `maintenance_mode` = "true" oculta temporalmente la tienda pública.
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Analítica de Marketing · visitas a la tienda pública.
model StoreVisit {
  id        String   @id @default(cuid())
  path      String   @default("/tienda")
  visitedAt DateTime @default(now())

  @@index([visitedAt])
}

// Analítica de Marketing · vistas de cada ficha de producto.
model ProductView {
  id        String   @id @default(cuid())
  productId String
  viewedAt  DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, viewedAt])
}