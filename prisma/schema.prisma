// Prisma schema for Dharma Kadabra
// PostgreSQL persistence for bookings, customers, store items and ritual events.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED") // Recomendado para Vercel (migraciones seguras)
}

enum Role {
  ADMIN
  ENGINEER
  SOCIAL_MEDIA
  COLLABORATOR
  CLIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
}

// Cuentas del equipo (dashboard). Se autentican con NextAuth (Credentials).
// Los clientes de la tienda usan el modelo Customer y su propia sesión.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(COLLABORATOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Appointment {
  id                String            @id @default(cuid())
  clientName        String
  clientEmail       String
  clientPhone       String
  date              DateTime
  service           String
  status            AppointmentStatus @default(PENDING)
  depositPaid       Boolean           @default(false)
  notificationsSent Json              @default("[]")
  customerId        String?
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([date, status])
  @@index([clientEmail, date])
}

model Customer {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  phone          String?
  passwordHash   String
  appointments   Appointment[]
  purchases      Purchase[]
  audioPurchases AudioPurchase[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Product {
  id           String         @id
  name         String
  description  String
  price        Float
  // Holistic Store · administración comercial
  cost         Float          @default(0)
  profitMargin Float          @default(0)
  currency     String         @default("MXN")
  availability String         @default("available")
  published    Boolean        @default(false)
  stock        Int            @default(0)
  imageUrl     String
  category     String
  events       SpecialEvent[] @relation("EventProducts")
  purchases    Purchase[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([category, published])
}

model SpecialEvent {
  id          String    @id @default(cuid())
  title       String
  description String
  date        DateTime
  products    Product[] @relation("EventProducts")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([date])
}

model Purchase {
  id         String   @id @default(cuid())
  customerId String
  productId  String?
  title      String
  purchasedAt DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([customerId, purchasedAt])
}

model AudioPurchase {
  id          String   @id @default(cuid())
  customerId  String
  title       String
  audioUrl    String?
  purchasedAt DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, purchasedAt])
}

// Holistic Store · plantilla visual asignada a cada categoría de la tienda.
// Valores de `template`: "oro" | "papiro" | "fuego" (ver modules/holistic-store).
model StoreCategoryStyle {
  category  String   @id
  template  String   @default("oro")
  updatedAt DateTime @updatedAt
}